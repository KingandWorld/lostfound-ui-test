# Day15：UI 自动化环境变量（复制为 .env 后填写；.env 已 gitignore，绝不入库）
# 与接口自动化项目（lostfound-api-test-示例）共用同一测试账号
# ⚠️ 公网仓库代码/文档一律用占位符：真实域名/端口只填 .env
BASE_URL=https://<服务器IP>:<端口>
TEST_USERNAME=test01
TEST_PASSWORD=Test123456
# 测试账号邮箱（邮箱登录用例用；与接口自动化项目的注册数据一致，example.com 保留域测试数据）
TEST_EMAIL=xxx

# 浏览器模式：True=headless 无头（默认，与服务器场景一致）；False=有头（本地调试）
# Windows 运行前设：$env:HEADLESS="false"
HEADLESS=True

# ============ Day19：Allure 报告上传腾讯云 COS（可选）============
# 与接口自动化项目（lostfound-api-test-示例）Day14 已配置的 COS_* 同款；
# 不配置时 upload_to_cos.py 会提示缺失并退出，不影响测试运行
# ⚠️ 桶名含账号 APPID 后缀，公网仓库代码/文档一律用 <COS桶名> 占位符
COS_SECRET_ID=<你的SecretId>
COS_SECRET_KEY=<你的SecretKey>
COS_BUCKET=<COS桶名>
COS_REGION=ap-guangzhou
# 报告外链域名（可选）：配置后 upload_to_cos.py 生成的 version.json 才写 report_url
COS_CDN_DOMAIN=https://<报告访问域名>
